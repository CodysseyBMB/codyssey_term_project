# Runtime environment: development, test, or production
APP_ENV=development

# Docker Compose PostgreSQL connection URL.
DATABASE_URL=postgresql://chatbot:chatbot@postgres:5432/chatbot

# At least 32 random characters. Use a different secret in production.
SESSION_SECRET=change-this-development-session-secret

# Codyssey "Neito" AI gateway. Never commit the real key — set it only in your local .env.
AI_API_KEY=
AI_BASE_URL=https://copa.codyssey.kr
AI_MODEL=claude-haiku-4
AI_TIMEOUT_SECONDS=10
